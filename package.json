{
  "name": "zink",
  "version": "0.1.0",
  "private": true,
  "description": "Zınk — reklamsız, yerel odaklı ikinci-el ilan ve alışveriş platformu",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api:dev": "pnpm --filter @zink/api dev",
    "api:migrate:local": "pnpm --filter @zink/api migrate:local",
    "api:seed:local": "pnpm --filter @zink/api seed:local",
    "web:dev": "pnpm --filter @zink/web dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "neverBuiltDependencies": ["sharp"]
  }
}
