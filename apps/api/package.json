{
  "name": "@satiyo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply satiyo --local",
    "migrate:remote": "wrangler d1 migrations apply satiyo --remote",
    "seed:local": "wrangler d1 execute satiyo --local --file ./seed.sql"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.7",
    "@satiyo/shared": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.101.0"
  }
}
