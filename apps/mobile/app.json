{
  "expo": {
    "name": "Satıyo",
    "slug": "satiyo",
    "version": "1.1.0",
    "scheme": "satiyo",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#f0434c",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0434c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.satiyo.app",
      "buildNumber": "14",
      "associatedDomains": ["applinks:satiyo.app"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "İlan fotoğrafı seçmek için galerinize erişim gerekir.",
        "NSCameraUsageDescription": "İlan fotoğrafı çekmek için kameranıza erişim gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.satiyo.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f0434c"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "satiyo.app", "pathPrefix": "/ilan" },
            { "scheme": "https", "host": "satiyo.app", "pathPrefix": "/satici" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan fotoğrafı eklemek için galeriye erişim.",
          "cameraPermission": "İlan fotoğrafı çekmek için kameraya erişim."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d087efea-1bfc-4928-934b-647b66a41a4e"
      }
    },
    "owner": "eraycaylak"
  }
}
